# Existing Perxona avatar presenter integration
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js
DEMO_FIXED_AVATAR_ID=
DEMO_FIXED_SCENE_ID=
DEMO_FIXED_VOICE_ID=
DEMO_FIXED_CHATBOT_ID=
USE_MOCK=false
PORT=8083
NODE_ENV=production

# OpenAI — key stays on the backend and is never sent to the browser
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# MongoDB Atlas connection string, including a database name
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/tiktok_live_host?retryWrites=true&w=majority

# Set a long random secret; enter the same value in the frontend control room
LIVE_ADMIN_TOKEN=replace_with_a_long_random_secret
# Comma-separated exact frontend origins; use * only for testing
FRONTEND_ORIGINS=http://localhost:5500,https://your-frontend.example.com

# Legacy chat route settings (optional)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
