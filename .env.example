# Existing Perxona avatar presenter integration
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js
DEMO_FIXED_AVATAR_ID=
DEMO_FIXED_SCENE_ID=
DEMO_FIXED_VOICE_ID=
DEMO_FIXED_CHATBOT_ID=
USE_MOCK=false
PORT=8083
NODE_ENV=production

# Optional OpenAI vision fallback. Text replies follow LLM_PROVIDER=groq.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LIVE_HOST_NAME=[HOST_NAME]
LIVE_BRAND_NAME=[BRAND_NAME]
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# MongoDB Atlas connection string, including a database name
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/tiktok_live_host?retryWrites=true&w=majority

# Set a long random secret; enter the same value in the frontend control room
LIVE_ADMIN_TOKEN=replace_with_a_long_random_secret
# Comma-separated exact frontend origins; use * only for testing
FRONTEND_ORIGINS=http://localhost:5500,https://your-frontend.example.com

# Studio own-LLM chat uses OPENAI_API_KEY above for OpenAI. Set LLM_API_KEY only
# to override that key or to use a different provider; LLM_BASE_URL is a base URL.
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional: Euler Stream API key used to sign TikTok LIVE connections (needed when the unsigned route is refused)
EULER_API_KEY=

# Likes are thanked in groups: after this many new likes, at most once per gap
LIKE_THANKS_EVERY=25
LIKE_THANKS_GAP_SECONDS=60

# Groq text model handles avatar replies and extracts relevant events from locally OCRed screen text.
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Generate a long random token and use it in the standalone ScreenCapture webhook URL.
SCREEN_CAPTURE_WEBHOOK_TOKEN=replace_with_a_long_random_secret
SCREEN_CAPTURE_LLM_TIMEOUT_MS=12000

# Optional: where "a new day" starts for viewer visit streaks (IANA name, default UTC)
LIVE_TIMEZONE=UTC
